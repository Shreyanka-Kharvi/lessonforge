# Pick ONE provider and fill its key. (LLM_PROVIDER is optional; auto-detected from the key.)
LLM_PROVIDER=anthropic          # anthropic | gemini | openai
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: override models. QC_MODEL lets the auditor be a different model than the writer.
# MODEL=
# QC_MODEL=

# Optional: YouTube Data API v3 key (free). Without it, video search falls back to DuckDuckGo.
YOUTUBE_API_KEY=
